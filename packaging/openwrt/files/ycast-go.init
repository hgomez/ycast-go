#!/bin/sh /etc/rc.common
# procd init script for ycast-go, installed as /etc/init.d/ycast.
#
# Before the first start: copy /etc/ycast/stations.yml.example to
# /etc/ycast/stations.yml and edit it, then:
#   /etc/init.d/ycast enable && /etc/init.d/ycast start
#
# The server binds port 80, which LuCI's uhttpd also occupies by default.
# Move LuCI first, or change -p here:
#   uci set uhttpd.main.listen_http='0.0.0.0:8080'
#   uci commit uhttpd && /etc/init.d/uhttpd restart

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ycast-go

start_service() {
	local stations=/etc/ycast/stations.yml

	# Fail loudly rather than start a server with an empty receiver menu.
	if [ ! -f "$stations" ]; then
		echo "ycast: $stations is missing — copy /etc/ycast/stations.yml.example and edit it" >&2
		exit 1
	fi

	procd_open_instance
	# Icons are cached in /tmp (RAM): wiped at reboot, re-downloaded on
	# demand; keeps writes off the flash.
	procd_set_param command "$PROG" -c "$stations" -p 80 -cache /tmp/ycast-icons
	# Respawn forever: at most 5 restarts per hour (procd's own backoff).
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
